ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
AUTH_COOKIE_SECURE=false
GEMINI_API_KEY=
# Optional fallback provider. Used only when GEMINI_API_KEY is empty.
GROQ_API_KEY=
# Set on the VM (2 ARM cores, no GPU). Measured 24 Nov 2026: a 2-page PDF with
# two charts was still parsing after 1 hour with this on, against 15-19 s off.
# The chart model is 6.15 GB and the CPU has no bf16 support. deploy.sh never
# touches the VM's .env, so this line is the only record that it needs this.
# CHART_EXTRACTION_ENABLED=false
